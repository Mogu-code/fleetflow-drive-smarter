# Database configuration
POSTGRES_USER=fleetflow_user
POSTGRES_PASSWORD=fleetflow_password
POSTGRES_DB=fleetflow
DATABASE_URL=postgresql+psycopg://fleetflow_user:fleetflow_password@localhost:5432/fleetflow

# API Configuration
PROJECT_NAME="FleetFlow API"
VERSION="1.0.0"
API_V1_STR="/api"

# Security
SECRET_KEY=development_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
